# Optional overrides. Nothing here is required: everything has a local default.
# Copy to .env (git-ignored) and uncomment what you need. Never commit real secrets.

# --- Read by docker compose ---------------------------------------------------

# Keep DEBUG on for the local stack: with DEBUG off, the settings refuse the
# built-in secret key, so DJANGO_SECRET_KEY must then be set as well.
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The refresh-token cookie is Secure whenever DEBUG is off. Set false only to run
# the production image over plain http, for example in Safari on localhost.
# DJANGO_REFRESH_COOKIE_SECURE=true

# Due-date rules ("can't be in the past", overdue) compare against the local
# date in this zone. Datetimes are still stored in UTC (USE_TZ).
# DJANGO_TIME_ZONE=UTC

# Demo data: the backend runs seed_demo on startup unless SEED_DEMO is not
# "true". The default password is for local use only: any deployment other
# people can reach must set its own, because the seed creates a superuser.
# (MIGRATE_ON_START is fixed per service: only the backend migrates.)
# SEED_DEMO=true
# SEED_DEMO_PASSWORD=demo-password

# Postgres credentials, and the host port the db is published on.
# POSTGRES_DB=taskboard
# POSTGRES_USER=taskboard
# POSTGRES_PASSWORD=taskboard
# POSTGRES_PORT=5433

# --- Read by Django when run on the host (uv run ...) -------------------------
# Django doesn't load .env: export these in your shell. Inside compose they are
# fixed to the compose services (db, redis, mailpit).

# DATABASE_URL=postgres://taskboard:taskboard@localhost:5433/taskboard
# REDIS_URL=redis://localhost:6379/0
# Without Redis on the host, use an in-process cache for the throttles. Its
# limits don't hold across processes, so never use it in production.
# DJANGO_CACHE=locmem
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=Team Task Board <noreply@localhost>
# Celery Beat's schedule file. Defaults to the system temp dir, outside the repo.
# CELERY_BEAT_SCHEDULE_FILENAME=
